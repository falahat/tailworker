def unpack_outputs(archive, target):
    target.mkdir(parents=True, exist_ok=True)
    with tarfile.open(archive) as contents:
        for item in contents:
            path = target / item.name
            if (not item.isdir() and not item.isfile()) or not path.resolve().is_relative_to(target.resolve()):
                raise ValueError('worker output contains a link, special file or escaping path')
        contents.extractall(target, filter='data')


def run(args):
    if not args.command:
        raise ValueError('run requires a command after --')
    if args.out and args.out.exists() and (not args.out.is_dir() or any(args.out.iterdir())):
        raise ValueError('output directory must be empty or absent')
    if args.receipt and (args.receipt.exists() or args.receipt.is_symlink() or
                         (args.out and args.receipt.resolve().is_relative_to(args.out.resolve()))):
        raise ValueError('receipt must be new and outside the output directory')
    machine = choose(args.on, args.gpu)
    host = machine['host']
    if output(host, ['podman', 'info', '--format', '{{.Host.Security.Rootless}}']) != 'true':
        raise ValueError('worker Podman must be rootless')
    try:
        image = 'sha256:' + output(host, ['podman', 'image', 'inspect', '--format', '{{.Id}}', args.image]).removeprefix('sha256:')
    except subprocess.CalledProcessError:
        raise ValueError('missing image; run tailworker image send ' + args.image + ' --to ' + machine['name']) from None
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', image):
        raise ValueError('worker returned an invalid image identity')
    call(host, ['python3', '-c', PRUNE])
    identifier = 'tw-' + uuid.uuid4().hex
    memory = args.memory or str(machine['capacity']['memory_bytes'] * 4 // 5)
    flags = ['--rm', '--name', identifier, '--pull=never', '--userns=keep-id', '--memory', memory,
             '--read-only', '--cap-drop=all', '--security-opt=no-new-privileges',
             '--tmpfs', '/tmp:rw,nosuid,nodev,size=1g', '--tmpfs', '/run:rw,nosuid,nodev,size=64m',
             '--network', 'pasta' if args.net else 'none']
    if args.inputs:
        flags += ['-v', cache_inputs(host, args.inputs) + ':/in:ro']
    remote_out = None
    if args.out:
        base = output(host, ['python3', '-c', 'import os; from pathlib import Path; p=Path(os.environ.get("XDG_CACHE_HOME",Path.home()/".cache"))/"tailworker/outputs"; p.mkdir(parents=True,exist_ok=True); print(p.resolve())'])
        remote_out = output(host, ['mktemp', '-d', base + '/' + identifier + '.XXXXXXXX'])
        flags += ['-v', remote_out + ':/out:rw']
    if args.gpu:
        flags += ['--device', 'nvidia.com/gpu=all', '-v', LOCKS + ':' + LOCKS + ':ro', '-e', 'TAILWORKER_GPU_LEASE_FD=3']
    receipt = output(host, ['python3', '-c', 'import os,pathlib,sys; print(pathlib.Path(os.environ.get("XDG_CACHE_HOME",pathlib.Path.home()/".cache"))/"tailworker/receipts"/sys.argv[1])', identifier + '.json'])
    launched = command(host, ['python3', '-c', RUN, LOCKS, receipt, '1' if args.gpu else '0', identifier, *flags, image, *args.command])
    print('machine=' + machine['name'] + ' container=' + identifier, flush=True)
    process = None
    try:
        process = subprocess.Popen(launched)
        result = process.wait()
    except KeyboardInterrupt:
        stopped = subprocess.run(command(host, ['python3', '-c', 'import os,pathlib,signal,sys; p=pathlib.Path(sys.argv[1]); p.with_suffix(".cancel").touch(); p=p.with_suffix(".pid"); os.kill(int(p.read_text()),signal.SIGINT) if p.exists() else None', receipt]), stdout=subprocess.DEVNULL)
        if stopped.returncode:
            print('Could not confirm cancellation of ' + identifier + ' on ' + machine['name'], file=sys.stderr)
        if process:
            process.wait()
        result = 130
    if args.receipt:
        value = json.loads(output(host, ['cat', receipt]))
        value.update(machine=machine['name'], host=host, image_id=image, container=identifier, gpu=args.gpu)
        args.receipt.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with os.fdopen(os.open(args.receipt, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as stream:
            stream.write(json.dumps(value, sort_keys=True) + '\n')
    call(host, ['python3', '-c', 'import pathlib,sys; p=pathlib.Path(sys.argv[1]); done=p.exists(); p.unlink(missing_ok=True); p.with_suffix(".cancel").unlink(missing_ok=True) if done else None', receipt])
    if remote_out:
        CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=CACHE) as temporary:
            archive = Path(temporary) / 'output.tar'
            with archive.open('wb') as stream:
                call(host, ['tar', '-cf', '-', '-C', remote_out, '.'], stdout=stream)
            unpack_outputs(archive, args.out)
        call(host, ['python3', '-c', 'import pathlib,shutil,sys; p=pathlib.Path(sys.argv[1]); assert p.parent.name=="outputs" and p.name.startswith("tw-") and p.resolve()==p; shutil.rmtree(p)', remote_out])
    return result


def image_send(args):
    machine = choose(args.to)
    source = ['docker'] if args.from_docker else ['podman']
    identifier = subprocess.check_output(source + ['image', 'inspect', '--format', '{{.Id}}', args.image], text=True).strip().removeprefix('sha256:')
    try:
        existing = output(machine['host'], ['podman', 'image', 'inspect', '--format', '{{.Id}}', args.image]).removeprefix('sha256:')
    except subprocess.CalledProcessError:
        existing = ''
    if existing == identifier:
        print('image cached=' + identifier)
        return
    pipe(source + ['save', args.image], command(machine['host'], ['bash', '-o', 'pipefail', '-c', 'zstd -q -d -c | podman load']))
    if output(machine['host'], ['podman', 'image', 'inspect', '--format', '{{.Id}}', args.image]).removeprefix('sha256:') != identifier:
        raise ValueError('transferred image identity differs')


def api(url, value=None, token=None, form=False, method=None):
    body = (urllib.parse.urlencode(value).encode() if form else json.dumps(value).encode()) if value is not None else None
    headers = {'Content-Type': 'application/x-www-form-urlencoded' if form else 'application/json', 'User-Agent': 'tailworker'}
    if token:
        headers['Authorization'] = 'Bearer ' + token
    origin, result = urllib.parse.urlsplit(url)[:2], []
    try:
        while True:
            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method=method)) as response:
                value = None if response.status == 204 else json.load(response)
                if not isinstance(value, list):
                    return value
                result.extend(value)
                link = re.search(r'<([^>]+)>;\s*rel="next"', response.headers.get('Link', ''))
                if not link:
                    return result
                url = link.group(1)
                if urllib.parse.urlsplit(url)[:2] != origin:
                    raise ValueError('provider pagination changed origin')
    except urllib.error.HTTPError as error:
        raise ValueError('provider request failed with HTTP ' + str(error.code)) from None


def private(name, token=False):
    path = CONFIG / name
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError('credentials require an owned private regular file')
    value = path.read_text().strip()
    if token and not re.fullmatch(r'[A-Za-z0-9_]+', value):
        raise ValueError('token file must contain one plain token')
    return value


def join_key(tags):
    credentials = json.loads(private('tailscale-oauth.json'))
    token = api('https://api.tailscale.com/api/v2/oauth/token',
                dict(grant_type='client_credentials', **credentials), form=True)['access_token']
    return api('https://api.tailscale.com/api/v2/tailnet/-/keys', dict(expirySeconds=900,
               capabilities=dict(devices=dict(create=dict(reusable=False, ephemeral=True,
                                                          preauthorized=True, tags=tags)))), token)['key']


def nodes():
    state = json.loads(subprocess.check_output(['tailscale', 'status', '--json'], text=True))
    return [state['Self'], *state.get('Peer', {}).values()]


def tailnet_address(node):
    address = ipaddress.ip_address(node['TailscaleIPs'][0])
    if address not in ipaddress.ip_network('100.64.0.0/10') and address not in ipaddress.ip_network('fd7a:115c:a1e0::/48'):
        raise ValueError('dedicated worker has no tailnet address')
    return str(address)


def gcloud(config, *arguments):
    return ['gcloud', '--quiet', '--project=' + config['gcp']['project'], 'compute', *arguments]


