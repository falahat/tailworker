def run(args):
    if not args.command:
        raise ValueError('run requires a command after --')
    value = profile(args.profile)
    found = {machine['name']: machine for machine in machines(settings())}
    aliases(list(found.values()))
    identifier = 'tw-' + uuid.uuid4().hex
    for name in value['machines']:
        machine = found.get(name)
        if machine is None or not machine['online']:
            continue
        invocation = ['python3','-c',EXEC,json.dumps(value),identifier]
        try:
            call(machine['host'], [*invocation,'check'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
        except subprocess.CalledProcessError:
            continue
    else:
        raise ValueError('no approved machine passed environment preflight')
    print('machine=' + name + ' container=' + identifier, file=sys.stderr, flush=True)
    process = subprocess.Popen(command(machine['host'], [*invocation,'run',*args.command]),
                               start_new_session=os.name == 'posix',
                               creationflags=subprocess.CREATE_NEW_PROCESS_GROUP if os.name == 'nt' else 0)
    def interrupt(*unused):
        raise KeyboardInterrupt
    previous = signal.signal(signal.SIGTERM, interrupt)
    previous_int = signal.getsignal(signal.SIGINT)
    try:
        return process.wait()
    except KeyboardInterrupt:
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        call(machine['host'], ['python3','-c',CANCEL,identifier], stdout=subprocess.DEVNULL)
        if process.wait() != 130:
            raise ValueError('run cancellation could not be confirmed')
        return 130
    finally:
        signal.signal(signal.SIGTERM, previous)
        signal.signal(signal.SIGINT, previous_int)


def image_send(args):
    machine = choose(args.to)
    identifier = subprocess.check_output(['podman', 'image', 'inspect', '--format', '{{.Id}}', args.image], text=True).strip().removeprefix('sha256:')
    try:
        existing = output(machine['host'], ['podman', 'image', 'inspect', '--format', '{{.Id}}', args.image]).removeprefix('sha256:')
    except subprocess.CalledProcessError:
        existing = ''
    if existing == identifier:
        print('image cached=' + identifier)
        return
    pipe(['podman', 'save', args.image], command(machine['host'], ['bash', '-o', 'pipefail', '-c', 'zstd -q -d -c | podman load']))
    if output(machine['host'], ['podman', 'image', 'inspect', '--format', '{{.Id}}', args.image]).removeprefix('sha256:') != identifier:
        raise ValueError('transferred image identity differs')


def api(url, value, token=None, form=False):
    body = urllib.parse.urlencode(value).encode() if form else json.dumps(value).encode()
    headers = {'Content-Type': 'application/x-www-form-urlencoded' if form else 'application/json', 'User-Agent': 'tailworker'}
    if token:
        headers['Authorization'] = 'Bearer ' + token
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers)) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        raise ValueError('provider request failed with HTTP ' + str(error.code)) from None


def private(name):
    return owned_private(CONFIG / name).read_text().strip()


def join_key(tags):
    credentials = json.loads(private('tailscale-oauth.json'))
    token = api('https://api.tailscale.com/api/v2/oauth/token',
                dict(grant_type='client_credentials', **credentials), form=True)['access_token']
    return api('https://api.tailscale.com/api/v2/tailnet/-/keys', dict(expirySeconds=900,
               capabilities=dict(devices=dict(create=dict(reusable=False, ephemeral=True,
                                                          preauthorized=True, tags=tags)))), token)['key']


def nodes():
    state = json.loads(subprocess.check_output(['tailscale', 'status', '--json'], text=True, stdin=subprocess.DEVNULL))
    return [state['Self'], *state.get('Peer', {}).values()]


def tailnet_address(node):
    address = ipaddress.ip_address(node['TailscaleIPs'][0])
    if address not in ipaddress.ip_network('100.64.0.0/10') and address not in ipaddress.ip_network('fd7a:115c:a1e0::/48'):
        raise ValueError('dedicated worker has no tailnet address')
    return str(address)


def gcloud(config, *arguments):
    return ['gcloud', '--quiet', '--project=' + config['gcp']['project'], 'compute', *arguments]


def up(args, config):
    if not 1 <= args.hours <= 24 or args.disk_gb <= 0 or not re.fullmatch(r'[a-z](?:[a-z0-9-]{0,58}[a-z0-9])?', args.name):
        raise ValueError('use a valid name and a hard lifetime from 1 through 24 hours')
    tags = sorted(set(['tag:tw', *args.tag]))
    if any(not re.fullmatch(r'tag:[a-z0-9-]+', tag) for tag in tags):
        raise ValueError('provide native worker tags')
    cloud = config['gcp']
    family = 'gpu_image_family' if args.gpu else 'image_family'
    project = 'gpu_image_project' if args.gpu else 'image_project'
    if not all(cloud.get(key) for key in ('project', 'zone', family, project)) or not (args.machine_type or cloud.get('machine_type')):
        raise ValueError('fill the cloud project, zone, machine type and image settings first')
    revision = output('local', ['git', '-C', str(Path(__file__).resolve().parent), 'rev-parse', 'HEAD'])
    alias = 'tw-' + args.name
    pins = (CONFIG / 'known_hosts').read_text() if (CONFIG / 'known_hosts').exists() else ''
    if args.name in config['owned'] or any(line.startswith(alias + ' ') for line in pins.splitlines()):
        raise ValueError('worker name already has an owned machine or host pin')
    baseline = [] if args.dry_run and not args.allow else nodes()
    if any(node['HostName'] in (args.name, alias) for node in baseline):
        raise ValueError('worker name already belongs to a tailnet node')
    allowed = []
    for item in args.allow:
        host, port = item.rsplit(':', 1)
        matching = [node for node in baseline if host in (node['HostName'], node.get('DNSName', '').rstrip('.'))]
        if len(matching) != 1 or not 0 < int(port) < 65536:
            raise ValueError('allow entries need one existing tailnet host and a TCP port')
        allowed.append(tailnet_address(matching[0]) + ':' + str(int(port)))
    expires = (datetime.now(timezone.utc) + timedelta(hours=args.hours)).isoformat()
    with tempfile.TemporaryDirectory(dir=CONFIG) as temporary:
        folder = Path(temporary)
        startup, auth, keys = [folder / name for name in ('startup.sh', 'authkey', 'authorized_keys')]
        save(startup, Path(__file__).with_name('bootstrap.sh').read_text().replace('@REVISION@', revision))
        creation = gcloud(config, 'instances', 'create', alias, '--zone=' + cloud['zone'],
            '--machine-type=' + (args.machine_type or cloud['machine_type']), '--network=tailworker', '--subnet=tailworker',
            '--no-address', '--no-service-account', '--no-scopes', '--max-run-duration=' + str(args.hours) + 'h',
            '--instance-termination-action=DELETE', '--image-family=' + cloud[family], '--image-project=' + cloud[project],
            '--boot-disk-size=' + str(args.disk_gb), '--labels=tailworker=1',
            '--metadata=block-project-ssh-keys=TRUE,enable-oslogin=FALSE,tw-name=' + alias + ',tw-tags=' + ' '.join(tags) +
            ',tw-allow=' + ' '.join(allowed) + ',tw-expires-at=' + expires,
            '--metadata-from-file=startup-script=' + str(startup) + ',tw-authkey=' + str(auth) + ',tw-authorized-keys=' + str(keys))
        if args.spot:
            creation.append('--provisioning-model=SPOT')
        if args.gpu:
            creation.append('--maintenance-policy=TERMINATE')
        if args.dry_run:
            print(shlex.join(creation))
            return
        call('local', ['git', '-C', str(Path(__file__).resolve().parent), 'diff', '--quiet', 'HEAD'])
        if json.loads(subprocess.check_output(gcloud(config, 'instances', 'list', '--filter=labels.tailworker=1', '--format=json'))):
            raise ValueError('a labelled worker instance already exists; inspect it first')
        entries = [('restrict', Path(path)) for path in config['ssh']['public_keys']]
        if config['ssh'].get('pty_public_key'):
            entries.append(('restrict,pty', Path(config['ssh']['pty_public_key'])))
        public = [option + ' ' + path.expanduser().read_text().strip() for option, path in entries]
        if not public or any(not re.fullmatch(r'restrict(?:,pty)? ssh-ed25519 [A-Za-z0-9+/]+={0,3}(?: [^\r\n]*)?', key) for key in public):
            raise ValueError('configure the approved submitters ed25519 public-key files')
        save(keys, '\n'.join(public) + '\n')
        save(auth, join_key(tags))
        try:
            subprocess.run(creation, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except BaseException:
            print(alias + ' may exist and bill until its hard lifetime; inspect it, no creation was retried.', file=sys.stderr)
            raise
    old = {node['ID'] for node in baseline}
    while True:
        current = nodes()
        matching = [node for node in current if node['HostName'] == alias]
        if len(matching) > 1 or any(node['ID'] in old or set(node.get('Tags', [])) != set(tags) for node in matching):
            raise ValueError('ambiguous, stale or incorrectly tagged worker identity')
        if matching and matching[0]['Online']:
            break
        print('Waiting for ' + alias + ' to join the tailnet', flush=True)
        time.sleep(1)
    address = tailnet_address(matching[0])
    scanned = subprocess.check_output(['ssh-keyscan', '-T', '5', '-t', 'ed25519', address], stderr=subprocess.DEVNULL, text=True)
    fields = [line.split() for line in scanned.splitlines() if not line.startswith('#')]
    if len(fields) != 1 or len(fields[0]) != 3 or fields[0][:2] != [address, 'ssh-ed25519']:
        raise ValueError('invalid initial worker host key')
    blob = base64.b64decode(fields[0][2], validate=True)
    if len(blob) != 51 or blob[:19] != b'\0\0\0\x0bssh-ed25519\0\0\0\x20':
        raise ValueError('invalid initial worker host key')
    save(CONFIG / 'known_hosts', pins + alias + ' ' + ' '.join(fields[0][1:]) + '\n')
    aliases(machines(config))
    while True:
        ready = subprocess.run(command(alias, ['cat', '/var/lib/tailworker/ready']), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if ready.returncode == 0:
            if ready.stdout.decode().strip() != revision:
                raise ValueError('worker bootstrap revision differs from reviewed source')
            break
        if ready.returncode != 1:
            raise ValueError('private worker SSH failed; no command was retried')
        print('Waiting for ' + alias + ' bootstrap', flush=True)
        time.sleep(1)
    print('ssh ' + alias + '; expires ' + expires)


def down(args, config):
    if not re.fullmatch(r'[a-z](?:[a-z0-9-]{0,58}[a-z0-9])?', args.name):
        raise ValueError('provide a valid worker name')
    alias, failed = 'tw-' + args.name, False
    instances = json.loads(subprocess.check_output(gcloud(config, 'instances', 'list', '--filter=name=' + alias, '--format=json')))
    if any(item['name'] != alias or item.get('labels', {}).get('tailworker') != '1' for item in instances):
        raise ValueError('refusing to remove an instance not owned by tailworker')
    # The root shutdown unit logs out; the job account never administers tailscaled.
    for item in instances:
        step = gcloud(config, 'instances', 'delete', alias, '--zone=' + item['zone'].rsplit('/', 1)[-1])
        result = subprocess.run(step, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode:
            print('Cleanup failed: ' + shlex.join(step), file=sys.stderr)
            failed = True
    try:
        absent = not any(node['HostName'] == alias for node in nodes())
    except subprocess.CalledProcessError:
        absent = False
    if not absent:
        print(alias + ' node removal is not independently confirmed; inspect tailnet status', file=sys.stderr)
        failed = True
    if failed:
        raise ValueError(alias + ' cleanup is incomplete; inspect the instance and node')
    known = CONFIG / 'known_hosts'
    pins = known.read_text() if known.exists() else ''
    save(known, ''.join(line + '\n' for line in pins.splitlines() if not line.startswith(alias + ' ')))
    aliases(machines(config))
    print(alias + ' removed; no step was retried')


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    for kind in ('job', 'service'):
        commands.add_parser(kind, help='native Cloud Run ' + kind + ' operations')
    commands.add_parser('setup')
    commands.add_parser('ls').add_argument('--json', action='store_true')
    commands.add_parser('resolve').add_argument('name')
    transport = commands.add_parser('ssh-argv')
    transport.add_argument('destination')
    transport.add_argument('--config', type=Path)
    transport.add_argument('--null', action='store_true')
    run_parser = commands.add_parser('run')
    run_parser.add_argument('--profile', required=True, type=Path)
    run_parser.add_argument('command', nargs=argparse.REMAINDER)
    images = commands.add_parser('image').add_subparsers(dest='image_action', required=True)
    send = images.add_parser('send')
    send.add_argument('image')
    send.add_argument('--to', required=True)
    create = commands.add_parser('up')
    create.add_argument('provider', choices=['gcp'])
    create.add_argument('--name', required=True)
    create.add_argument('--hours', type=int, required=True)
    for flag in ('gpu', 'spot', 'dry-run'):
        create.add_argument('--' + flag, action='store_true')
    create.add_argument('--machine-type')
    create.add_argument('--disk-gb', type=int, default=200)
    for flag in ('tag', 'allow'):
        create.add_argument('--' + flag, action='append', default=[])
    commands.add_parser('down').add_argument('name')
    args = parser.parse_args()
    if args.action == 'setup':
        setup()
    elif args.action == 'ls':
        listing(args.json)
    elif args.action == 'resolve':
        machine = choose(args.name)
        machine['runtime'] = runtime(machine)
        print(json.dumps(machine))
    elif args.action == 'ssh-argv':
        argv = ssh_argv(args.destination, args.config)
        if args.null:
            sys.stdout.buffer.write(('\0'.join(argv) + '\0').encode())
        else:
            print(json.dumps(argv))
    elif args.action == 'run':
        args.command = args.command[1:] if args.command[:1] == ['--'] else args.command
        return run(args)
    elif args.action == 'image':
        image_send(args)
    else:
        import fcntl
        with (CONFIG / 'cloud.lock').open('a+') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            (up if args.action == 'up' else down)(args, settings())
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        sys.exit('tailworker: ' + str(error))
