def pipe(source, destination):
    with subprocess.Popen(source, stdout=subprocess.PIPE) as producer:
        with subprocess.Popen(['zstd', '-q', '-T1', '-c'], stdin=producer.stdout, stdout=subprocess.PIPE) as compressor:
            producer.stdout.close()
            try:
                subprocess.run(destination, stdin=compressor.stdout, check=True)
            finally:
                compressor.stdout.close()
            if compressor.wait() or producer.wait():
                raise ValueError('source or compression failed during transfer')


def profile(path):
    base = CONFIG / 'profiles'
    path = path.expanduser().absolute()
    if path != path.resolve(strict=True) or not path.is_relative_to(base.resolve()) or not path.is_file():
        raise ValueError('profile must be a regular file under the owner configuration profiles directory')
    if os.name == 'nt':
        # Native ACLs, rather than Windows' emulated POSIX mode bits, protect policy.
        script = "$ErrorActionPreference='Stop';$p='" + str(path).replace("'", "''") + "';$me=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value;"
        script += "$stop='" + str(CONFIG.parent).replace("'", "''") + "';$ok=@($me,'S-1-5-18','S-1-5-32-544');while($p){$a=Get-Acl -LiteralPath $p;if($a.GetOwner([Security.Principal.SecurityIdentifier]).Value -notin $ok){exit 1};"
        script += "foreach($r in $a.Access){if($r.AccessControlType -eq 'Allow' -and ([int]$r.FileSystemRights -band 852310) -and $r.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value -notin $ok){exit 1}};if($p -eq $stop){break};$p=Split-Path -Parent $p}"
        subprocess.run([shutil.which('pwsh') or 'powershell', '-NoProfile', '-NonInteractive', '-EncodedCommand',
                        base64.b64encode(script.encode('utf-16le')).decode()], check=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    else:
        for item in (path, *path.parents):
            if item.stat().st_uid != os.getuid() or item.stat().st_mode & 0o022:
                raise ValueError('profile and its parents must not be writable by other users')
            if item == CONFIG.parent:
                break
    value = tomllib.loads(path.read_text())
    required = {'machines', 'image', 'cpus', 'memory_bytes', 'min_free_bytes', 'workdir', 'mounts'}
    if not required <= value.keys() or value.keys() - required - {'gpu', 'env'}:
        raise ValueError('profile has missing or unknown settings')
    if not isinstance(value['machines'], list) or not value['machines'] or any(not isinstance(name, str) or not re.fullmatch('[a-z][a-z0-9-]*', name) for name in value['machines']):
        raise ValueError('profile requires explicit approved machine names')
    if not re.fullmatch('sha256:[0-9a-f]{64}', value['image']) or any(type(value[key]) is not int or value[key] <= 0 for key in ('cpus', 'memory_bytes', 'min_free_bytes')):
        raise ValueError('profile requires an immutable image and positive resource limits')
    if type(value.get('gpu', False)) is not bool or not isinstance(value.get('env', {}), dict):
        raise ValueError('invalid GPU or environment settings')
    for key, item in value.get('env', {}).items():
        if not re.fullmatch('[A-Za-z_][A-Za-z0-9_]*', key) or key.startswith('TAILWORKER_') or not isinstance(item, str) or '\0' in item:
            raise ValueError('invalid or reserved public environment setting')
    if not isinstance(value['mounts'], list):
        raise ValueError('profile requires explicit persistent mounts')
    paths = [value['workdir']]
    for mount in value['mounts']:
        if set(mount) != {'source', 'target', 'read_only'} or type(mount['read_only']) is not bool:
            raise ValueError('each mount requires source, target and read_only')
        paths.extend((mount['source'], mount['target']))
    if any(not isinstance(item, str) or not item.startswith('/') or any(part in ('', '.', '..') for part in item[1:].split('/')) or any(c in item for c in ':,\0\n') for item in paths):
        raise ValueError('mounts and workdir require normalized absolute Linux paths')
    targets = [mount['target'] for mount in value['mounts']]
    if len(set(targets)) != len(targets) or any(target.split('/')[1] in ('run', 'proc', 'sys', 'dev') for target in targets):
        raise ValueError('mount targets must be unique and outside reserved system directories')
    return value


